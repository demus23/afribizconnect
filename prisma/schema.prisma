generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  IMPORTER
  DISTRIBUTOR
  SUPPLIER
  LOGISTICS_PROVIDER
  INVESTOR
  PRIVATE_EQUITY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum OpportunityType {
  EQUITY
  DEBT
  TRADE_FINANCE
  JOINT_VENTURE
  ACQUISITION
}

enum ShipmentStatus {
  DRAFT
  CONFIRMED
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  CANCELLED
}

enum RFQStatus {
  OPEN
  IN_REVIEW
  AWARDED
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  supabaseId   String    @unique
  email        String    @unique
  name         String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business?
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  subscription Subscription?
}

model Business {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  name               String
  slug               String             @unique
  type               BusinessType
  description        String?
  logoUrl            String?
  websiteUrl         String?
  country            String
  city               String?
  foundedYear        Int?
  employeeCount      String?
  annualRevenue      String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  trustScore         Int                @default(0)
  verifiedAt         DateTime?
  categories         String[]
  certifications     String[]
  targetMarkets      String[]
  minOrderValue      Float?
  maxOrderValue      Float?
  leadTimeDays       Int?
  paymentTerms       String[]
  documents          Document[]
  asSupplier         SupplierProfile?
  opportunities      InvestmentOpportunity[]
  rfqs               RFQ[]
  shipments          Shipment[]
  logisticsQuotes    LogisticsQuote[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([country])
  @@index([type])
  @@index([trustScore])
}

model SupplierProfile {
  id               String   @id @default(cuid())
  businessId       String   @unique
  business         Business @relation(fields: [businessId], references: [id])
  headline         String
  specializations  String[]
  exportLicenses   String[]
  productionCap    String?
  qualityStandards String[]
  sampleAvailable  Boolean  @default(false)
  oemCapable       Boolean  @default(false)
  privateLabel     Boolean  @default(false)
  featured         Boolean  @default(false)
  viewCount        Int      @default(0)
  inquiryCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InvestmentOpportunity {
  id             String          @id @default(cuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id])
  title          String
  slug           String          @unique
  type           OpportunityType
  description    String
  sector         String
  country        String
  targetAmount   Float
  minimumTicket  Float
  currency       String          @default("USD")
  expectedReturn Float?
  timeline       String?
  stage          String?
  isActive       Boolean         @default(true)
  deadline       DateTime?
  viewCount      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sector])
  @@index([country])
}

model RFQ {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  title           String
  description     String
  category        String
  quantity        String
  unit            String
  targetPrice     Float?
  currency        String    @default("USD")
  deliveryCountry String
  deliveryDate    DateTime?
  requirements    String[]
  status          RFQStatus @default(OPEN)
  responseCount   Int       @default(0)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([status])
}

model LogisticsQuote {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  origin        String
  destination   String
  cargoType     String
  weight        Float
  volume        Float?
  incoterms     String
  requestedDate DateTime
  notes         String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Shipment {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id])
  trackingNumber   String?
  carrier          String?
  status           ShipmentStatus @default(DRAFT)
  origin           String
  destination      String
  estimatedArrival DateTime?
  actualArrival    DateTime?
  cargo            Json
  documents        Document[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Document {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  name       String
  type       String
  url        String
  size       Int
  uploadedAt DateTime  @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  tier                 PlanTier  @default(FREE)
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
